<div class="min-h-screen bg-amber-50 py-10 px-4">
  <div class="max-w-2xl mx-auto">
    <% if alert = flash[:alert] %>
      <p class="py-2 px-3 bg-red-50 mb-5 text-red-700 font-medium rounded-lg" id="alert"><%= alert %></p>
    <% end %>

    <% if notice = flash[:notice] %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-lg" id="notice"><%= notice %></p>
    <% end %>

    <div class="bg-white rounded shadow p-6 sm:p-8 mb-6">
      <h1 class="font-bold text-3xl">Your profile</h1>

      <dl class="mt-6 space-y-5">
        <div>
          <dt class="text-sm text-gray-500">Email address</dt>
          <dd class="text-base font-medium mt-0.5"><%= @user.email_address %></dd>
        </div>

        <div>
          <dt class="text-sm text-gray-500">Account type</dt>
          <dd class="text-base font-medium mt-0.5"><%= @user.owner? ? "Library owner" : "Member" %></dd>
        </div>

        <div>
          <dt class="text-sm text-gray-500">Member record</dt>
          <% if @borrower %>
            <dd class="text-base font-medium mt-0.5"><%= @borrower.name %> &middot; Standing <%= @borrower.standing %>/100</dd>
            <dd class="mt-1 text-sm"><%= link_to "View my loans and reading list", "/borrowers/#{@borrower.id}", class: "text-amber-800 underline hover:no-underline" %></dd>
          <% else %>
            <dd class="text-base mt-0.5">Not linked yet. If the library owner adds a member record with this email address, it connects to your account automatically.</dd>
          <% end %>
        </div>
      </dl>

      <p class="mt-8 text-sm"><%= link_to "&larr; Back to the library".html_safe, root_path, class: "text-amber-800 underline hover:no-underline" %></p>
    </div>

    <div class="bg-white rounded shadow p-6 sm:p-8">
      <h2 class="font-bold text-2xl">Change your password</h2>

      <%= form_with url: profile_path, method: :patch, class: "contents" do |form| %>
        <div class="my-5">
          <%= form.label :current_password, "Current password", class: "block text-sm text-gray-700 mb-1" %>
          <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "block shadow-sm rounded-md border border-gray-300 focus:outline-amber-700 px-3 py-2 w-full" %>
        </div>

        <div class="my-5">
          <%= form.label :password, "New password", class: "block text-sm text-gray-700 mb-1" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-amber-700 px-3 py-2 w-full" %>
        </div>

        <div class="my-5">
          <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm text-gray-700 mb-1" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-amber-700 px-3 py-2 w-full" %>
        </div>

        <%= form.submit "Update password", class: "text-center rounded px-4 py-2 bg-amber-800 hover:bg-amber-900 text-amber-50 font-medium cursor-pointer" %>
      <% end %>

      <p class="text-sm text-gray-500 mt-3">Updating your password signs you out on your other devices.</p>
    </div>
  </div>
</div>
