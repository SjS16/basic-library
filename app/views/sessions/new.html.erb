<div class="min-h-screen bg-amber-50 py-10 px-4">
  <div class="max-w-md mx-auto bg-white rounded shadow p-6 sm:p-8">
    <% if alert = flash[:alert] %>
      <p class="py-2 px-3 bg-red-50 mb-5 text-red-700 font-medium rounded-lg" id="alert"><%= alert %></p>
    <% end %>

    <% if notice = flash[:notice] %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-lg" id="notice"><%= notice %></p>
    <% end %>

    <h1 class="font-bold text-3xl">Sign in</h1>
    <p class="text-sm text-gray-600 mt-1 mb-6">Browse the shelves, check your loans, build your want-to-read list.</p>

    <%= form_with url: session_url, class: "contents" do |form| %>
      <div class="my-5">
        <%= form.label :email_address, "Email address", class: "block text-sm text-gray-700 mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address], class: "block shadow-sm rounded-md border border-gray-300 focus:outline-amber-700 px-3 py-2 w-full" %>
      </div>

      <div class="my-5">
        <%= form.label :password, "Password", class: "block text-sm text-gray-700 mb-1" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-amber-700 px-3 py-2 w-full" %>
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mt-6">
        <%= form.submit "Sign in", class: "text-center rounded px-4 py-2 bg-amber-800 hover:bg-amber-900 text-amber-50 font-medium cursor-pointer" %>

        <div class="text-sm text-gray-500">
          <%= link_to "Forgot password?", new_password_path, class: "text-amber-800 underline hover:no-underline" %>
          <span class="mx-1">&middot;</span>
          <%= link_to "Create an account", new_registration_path, class: "text-amber-800 underline hover:no-underline" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
